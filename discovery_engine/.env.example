# Copy to .env and fill in. Required for classification.
GROQ_API_KEY=your_groq_key_here
# Optional: override default Groq model
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: only needed to collect Reddit data
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gphotos-discovery/0.1

# Optional: only needed to collect YouTube comments (free key: Google Cloud console ->
# YouTube Data API v3 -> Credentials -> API key)
YOUTUBE_API_KEY=
